  "_batch_mapping_guidelines": {
    "step_1": "读取角色卡 role 字段确定模板",
    "step_2": "套用模板默认 dice/attr/range/cd",
    "step_3": "为每个英雄的 1-2 个 signature 技能定制 effect（基于 LoL 技能机制）",
    "step_4": "校验骰期望落入 §3.2 配额带",
    "step_5": "校验 effects.type 命中 mechanics.py 别名表",
    "step_6": "描述用 D&D 风味改写，禁止逐字复制 wiki",
    "cd_check": "槽0 CD==0，平均CD≤3.0，最大CD≤5",
    "effects_per_skill_max": 3,
    "effects_per_hero_max": 8,
    "control_duration_per_hero_max": 4,
    "on_save_invalid_per_hero_max": 1
  }
