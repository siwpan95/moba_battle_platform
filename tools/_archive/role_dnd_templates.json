      },
      "W": {
        "damage": { "dice_count": 2, "dice_size": 6, "bonus_attr": "INT", "type": "力场" },
        "cooldown": 1,
        "range": "近战",
        "target": "范围",
        "effects_hint": "必选：control（眩晕/冻结/束缚）",
        "saving_throw_hint": "CON 豁免无效（推荐）"
      },
      "E": {
        "damage": { "dice_count": 2, "dice_size": 6, "bonus_attr": "INT", "type": "力场" },
        "cooldown": 2,
        "range": "远程",
        "target": "范围",
        "effects_hint": "可选：accel（位移）/ slow / dot",
        "saving_throw_hint": "DEX 豁免半伤（推荐）"
      },
      "R": {
        "damage": { "dice_count": 4, "dice_size": 6, "bonus_attr": "INT", "type": "力场" },
