{
  "_meta": {
    "version": "1.0.0",
    "created": "2026-08-06",
    "author": "文策渊 (design-strategist)",
    "description": "6 role 的 D&D 5e 技能映射模板，用于 LoL 全量英雄技能批量生成。基于 pilot 5 英雄（丽桑卓/凯特琳/卡兹克/内瑟斯/吉格斯）校准。",
    "gdd_ref": "design/gdd/content-expansion.md §3.2 骰值预算规则",
    "cd_default": [0, 1, 2, 4],
    "dc_formula_format": "8+PROF+<主属性>",
    "effects_alias_ref": "core/mechanics.py categorize_effect 别名表"
  },

  "assassin": {
    "label": "刺客",
    "description": "高爆发近战/中距，依赖隐身/位移/孤立击杀。低 HP 换高骰期望。",
    "primary_attr": "DEX",
    "secondary_attr": "STR",
    "damage_type_default": "挥砍",
    "dice_expectancy_target": [32, 34],
    "range_default": "近战",
    "action_default": "动作",
    "common_effects": ["invis", "accel", "execute", "dot", "slow"],
    "saving_throw_attr_default": "DEX",
    "saving_throw_coverage": "≥50%",
    "slots": {
      "Q": {
        "damage": { "dice_count": 1, "dice_size": 10, "bonus_attr": "DEX", "type": "挥砍" },
        "cooldown": 0,
        "range": "近战",
        "target": "单体",
        "effects_hint": "可选：execute（孤立增伤）",
        "saving_throw_hint": "通常无"
      },
      "W": {
        "damage": { "dice_count": 2, "dice_size": 8, "bonus_attr": "DEX", "type": "穿刺" },
        "cooldown": 1,
        "range": "远程",
        "target": "单体",
        "effects_hint": "可选：slow / dot / 远程poke",
        "saving_throw_hint": "DEX 豁免半伤"
      },
      "E": {
        "damage": { "dice_count": 1, "dice_size": 8, "bonus_attr": "DEX", "type": "挥砍" },
        "cooldown": 2,
        "range": "远程",
        "target": "单体",
        "effects_hint": "必选：accel（位移/跳跃/闪避）",
        "saving_throw_hint": "通常无"
      },
      "R": {
        "damage": { "dice_count": 4, "dice_size": 6, "bonus_attr": "DEX", "type": "挥砍" },
        "cooldown": 4,
        "range": "近战",
        "target": "单体",
        "effects_hint": "必选：invis + accel + buff 中 2-3 个",
        "saving_throw_hint": "通常无"
      }
    },
    "dice_expectancy_calc": "Q=1×5.5 + W=2×4.5 + E=1×4.5 + R=4×3.5 = 5.5+9+4.5+14 = 33.0",
    "reference_heroes": ["卡兹克", "劫", "阿卡丽", "艾克"]
  },

