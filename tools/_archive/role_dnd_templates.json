    "dice_expectancy_calc": "Q=1×4.5 + W=2×3.5 + E=2×3.5 + R=4×3.5 = 4.5+7+7+14 = 32.5",
    "reference_heroes": ["丽桑卓", "吉格斯", "辛德拉", "拉克丝"]
  },

